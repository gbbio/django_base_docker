# Copy to .env and adjust as needed (docker compose loads .env automatically)
COMPOSE_PROJECT_NAME=django_base

# Outer folder: requirements.txt lives here
DJANGO_PROJECT_FOLDER=django_project_folder
# Inner folder: manage.py lives here (mounted to /app)
DJANGO_APP_DIR=django_project

POSTGRES_DB=django_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

DJANGO_PORT=8000
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
DJANGO_ALLOWED_HOSTS=*

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# Match your host user for bind-mount write permissions (id -u / id -g)
USER_ID=1000
GROUP_ID=1000

# DB backups (db_backup service) — schedule is container local time (UTC in postgres image)
BACKUP_HOUR=2
BACKUP_MINUTE=0
BACKUP_KEEP_DAILY=4
BACKUP_KEEP_WEEKLY=2
BACKUP_KEEP_MONTHLY=2
